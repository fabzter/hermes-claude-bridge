#!/usr/bin/env bash
# claude-bridge — lets Hermes (Bean) hold a real conversation with Claude Code.
#
# This is the mirror image of ~/.claude/skills/hermes-bridge (Claude -> Hermes).
# Here Hermes drives Claude Code headlessly (`claude -p`) while keeping ONE
# continuing conversation per session name, so follow-up questions have context.
#
# Subcommands:
#   ask [opts] MESSAGE     ask Claude; prints Claude's reply on stdout
#   ask-file [opts] FILE   same, but the message body is a file (multiline safe)
#   session [opts]         print the stored Claude session id for this name
#   reset [opts]           forget the session id (next ask starts fresh)
#   list                   list known session names and ids
#
# Options: --session NAME (default: bean) | --timeout SECONDS (default: 300)
#          --cwd DIR (default: $HOME) | --tools "T1 T2" | --model NAME
#
# Exit codes: 0 ok | 1 error | 2 bad usage | 6 timeout | 7 claude CLI not found
set -euo pipefail

CLAUDE_BIN="${CLAUDE_BIN:-$(command -v claude || true)}"
STATE_DIR="$HOME/.hermes/skills/claude-bridge/state"
SESSION="bean"
TIMEOUT=300
WORKDIR="$HOME"
# Read-only by default: Claude can look things up and reason, but cannot write,
# edit, or run shell commands on Hermes's behalf. Anything outside this list is
# denied (headless has no human to approve it) -- fail closed on purpose.
TOOLS="Read Grep Glob WebSearch WebFetch"
MODEL=""

err() { printf '%s\n' "$*" >&2; }

usage() { sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; }

is_valid_name() { [[ "$1" =~ ^[A-Za-z0-9._-]{1,64}$ ]]; }

parse_opts() {
  POSITIONAL=()
  while (( $# )); do
    case "$1" in
      --session) SESSION="${2:-}"; shift 2 ;;
      --timeout) TIMEOUT="${2:-}"; shift 2 ;;
      --cwd)     WORKDIR="${2:-}"; shift 2 ;;
      --tools)   TOOLS="${2:-}"; shift 2 ;;
      --model)   MODEL="${2:-}"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      --) shift; while (( $# )); do POSITIONAL+=("$1"); shift; done ;;
      -*) err "claude-bridge: unknown option '$1'"; exit 2 ;;
      *)  POSITIONAL+=("$1"); shift ;;
    esac
  done
  is_valid_name "$SESSION" || { err "claude-bridge: invalid --session '$SESSION' (letters, digits, . _ - ; 1-64)"; exit 2; }
  [[ "$TIMEOUT" =~ ^[0-9]+$ ]] || { err "claude-bridge: --timeout must be a whole number of seconds"; exit 2; }
  [[ -d "$WORKDIR" ]] || { err "claude-bridge: --cwd '$WORKDIR' is not a directory"; exit 2; }
}

id_file() { printf '%s/%s.session-id' "$STATE_DIR" "$SESSION"; }

load_id() { local f; f="$(id_file)"; if [[ -r "$f" ]]; then cat "$f"; fi; return 0; }

save_id() {
  local id="$1"
  [[ "$id" =~ ^[0-9a-fA-F-]{36}$ ]] || return 0
  mkdir -p "$STATE_DIR"; printf '%s' "$id" > "$(id_file)"
}

# Portable timeout: macOS has no coreutils `timeout` by default.
run_claude() {
  local outf="$1" errf="$2"; shift 2
  "$CLAUDE_BIN" "$@" >"$outf" 2>"$errf" &
  local pid=$! waited=0
  while kill -0 "$pid" 2>/dev/null; do
    if (( waited >= TIMEOUT )); then
      kill -TERM "$pid" 2>/dev/null || true; sleep 1
      kill -9 "$pid" 2>/dev/null || true
      return 124
    fi
    sleep 1; waited=$(( waited + 1 ))
  done
  wait "$pid"
}

do_ask() {
  local message="$1"
  [[ -n "$message" ]] || { err "claude-bridge: empty message"; exit 2; }
  [[ -n "$CLAUDE_BIN" && -x "$CLAUDE_BIN" ]] || { err "claude-bridge: 'claude' CLI not found (set CLAUDE_BIN)"; exit 7; }

  local prior; prior="$(load_id)"
  local -a args=(-p "$message" --output-format json --allowedTools $TOOLS)
  [[ -n "$MODEL" ]] && args+=(--model "$MODEL")
  local fresh_id=""
  if [[ -n "$prior" ]]; then
    args+=(--resume "$prior")
  else
    fresh_id="$(uuidgen | tr 'A-Z' 'a-z')"
    args+=(--session-id "$fresh_id")
  fi

  local outf errf rc=0
  outf="$(mktemp)"; errf="$(mktemp)"
  ( cd "$WORKDIR" && exec_dir=1 ) 2>/dev/null || true
  pushd "$WORKDIR" >/dev/null
  run_claude "$outf" "$errf" "${args[@]}" || rc=$?
  popd >/dev/null

  if (( rc == 124 )); then
    err "claude-bridge: timed out after ${TIMEOUT}s (Claude may still have been working; try a longer --timeout)"
    rm -f "$outf" "$errf"; exit 6
  fi

  if (( rc != 0 )); then
    # A stale/unknown session id is the common recoverable failure.
    if grep -qiE 'no conversation found|session.*not found|invalid session' "$errf" 2>/dev/null; then
      err "claude-bridge: stored session id was stale; starting a fresh conversation"
      rm -f "$(id_file)"
      rm -f "$outf" "$errf"
      do_ask "$message"
      return
    fi
    err "claude-bridge: claude exited $rc"
    sed -n '1,15p' "$errf" >&2
    rm -f "$outf" "$errf"; exit 1
  fi

  local reply sid
  reply="$(jq -r 'if type=="object" then (.result // .text // empty) else empty end' "$outf" 2>/dev/null || true)"
  sid="$(jq -r 'if type=="object" then (.session_id // empty) else empty end' "$outf" 2>/dev/null || true)"
  [[ -n "$sid" ]] && save_id "$sid" || { [[ -n "$fresh_id" ]] && save_id "$fresh_id"; }

  if [[ -z "$reply" ]]; then
    err "claude-bridge: could not parse a reply from Claude's output; raw output follows"
    cat "$outf" >&2
    rm -f "$outf" "$errf"; exit 1
  fi
  printf '%s\n' "$reply"
  rm -f "$outf" "$errf"
}

main() {
  local cmd="${1:-}"; [[ $# -gt 0 ]] && shift || true
  case "$cmd" in
    ask)
      parse_opts "$@"
      do_ask "${POSITIONAL[*]:-}"
      ;;
    ask-file)
      parse_opts "$@"
      local f="${POSITIONAL[0]:-}"
      [[ -n "$f" && -r "$f" ]] || { err "claude-bridge: ask-file needs a readable FILE"; exit 2; }
      [[ -s "$f" ]] || { err "claude-bridge: '$f' is empty"; exit 2; }
      do_ask "$(cat "$f")"
      ;;
    session)
      parse_opts "$@"
      local id; id="$(load_id)"
      if [[ -n "$id" ]]; then printf '%s\n' "$id"; else err "claude-bridge: no session stored for '$SESSION'"; exit 1; fi
      ;;
    reset)
      parse_opts "$@"
      rm -f "$(id_file)"
      printf "claude-bridge: session '%s' reset; next ask starts a fresh conversation\n" "$SESSION"
      ;;
    list)
      mkdir -p "$STATE_DIR"
      local found=0
      for f in "$STATE_DIR"/*.session-id; do
        [[ -e "$f" ]] || continue
        found=1
        printf '%s\t%s\n' "$(basename "$f" .session-id)" "$(cat "$f")"
      done
      (( found )) || echo "claude-bridge: no sessions yet"
      ;;
    ''|-h|--help|help) usage ;;
    *) err "claude-bridge: unknown subcommand '$cmd'"; usage >&2; exit 2 ;;
  esac
}
main "$@"
